{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oblique",
  "version": "../package.json",
  "identifier": "nz.preset.oblique",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Oblique",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../sidecar/dist/oblique-sidecar/": "sidecar-dist/"
    },
    "fileAssociations": [
      {
        "ext": ["oblique"],
        "name": "Oblique Document",
        "role": "Editor",
        "rank": "Owner",
        "contentTypes": ["nz.preset.oblique.document"],
        "exportedType": {
          "identifier": "nz.preset.oblique.document",
          "conformsTo": ["public.data", "public.content"]
        }
      }
    ]
  }
}
